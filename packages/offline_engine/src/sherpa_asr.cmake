# Only build the inference code needed by this app. Upstream TTS packages carry
# dependencies with different licenses; disabling TTS also skips fetching them.
if(ANDROID OR IOS)
    if(DEFINED ENV{LINGO_BUILD_PYTHON})
        set(Python3_EXECUTABLE "$ENV{LINGO_BUILD_PYTHON}")
    endif()
    find_package(Python3 3.11 REQUIRED COMPONENTS Interpreter)
    get_filename_component(LS_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/../../.." ABSOLUTE)
    execute_process(COMMAND "${Python3_EXECUTABLE}" "${LS_ROOT}/tools/prepare_sherpa_source.py"
        RESULT_VARIABLE LS_SOURCE_STATUS OUTPUT_VARIABLE LS_SOURCE_OUTPUT ERROR_VARIABLE LS_SOURCE_ERROR)
    if(NOT LS_SOURCE_STATUS EQUAL 0)
        message(FATAL_ERROR "Cannot prepare pinned ASR source: ${LS_SOURCE_ERROR}")
    endif()
    foreach(LS_OPTION IN ITEMS TTS SPEAKER_DIARIZATION PYTHON TESTS CHECK PORTAUDIO JNI WEBSOCKET GPU DIRECTML BINARY)
        set(SHERPA_ONNX_ENABLE_${LS_OPTION} OFF CACHE BOOL "" FORCE)
    endforeach()
    set(SHERPA_ONNX_ENABLE_C_API ON CACHE BOOL "" FORCE)
    add_compile_definitions(EIGEN_MPL2_ONLY=1)
    if(ANDROID)
        set(SHERPA_ONNX_USE_PRE_INSTALLED_ONNXRUNTIME_IF_AVAILABLE OFF CACHE BOOL "" FORCE)
    else()
        set(SHERPA_ONNX_USE_PRE_INSTALLED_ONNXRUNTIME_IF_AVAILABLE ON CACHE BOOL "" FORCE)
    endif()
    add_subdirectory("${LS_ROOT}/build/sherpa-source" sherpa-build EXCLUDE_FROM_ALL)
    set_target_properties(sherpa-onnx-c-api PROPERTIES CXX_VISIBILITY_PRESET default VISIBILITY_INLINES_HIDDEN OFF)
    target_sources(offline_engine PRIVATE sherpa_exports.cpp)
    target_link_libraries(offline_engine PRIVATE sherpa-onnx-c-api)
    get_target_property(LS_SHERPA_LINK_INPUTS sherpa-onnx-core LINK_LIBRARIES)
    set(LS_IMPORTED_ARCHIVES "")
    foreach(LS_INPUT IN LISTS LS_SHERPA_LINK_INPUTS)
        if(IS_ABSOLUTE "${LS_INPUT}" AND EXISTS "${LS_INPUT}")
            string(APPEND LS_IMPORTED_ARCHIVES "${LS_INPUT}\n")
        endif()
    endforeach()
    file(WRITE "${CMAKE_BINARY_DIR}/sherpa-imported-archives.txt" "${LS_IMPORTED_ARCHIVES}")
    file(WRITE "${CMAKE_BINARY_DIR}/sherpa-build-scope.json"
        "{\"revision\":\"11afbd009a7f8c08f4bcf2fc1b265d0df4670fbf\",\"tts\":false,\"diarization\":false,\"gpu\":false,\"websocket\":false,\"sourceBuilt\":true}\n")
endif()
