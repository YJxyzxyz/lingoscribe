# Normalize text in Git and retain CRLF for Windows command scripts.
* text=auto
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Preserve vendored source and license notices, including upstream whitespace.
native/vendor/** -whitespace
docs/licenses/** -whitespace
